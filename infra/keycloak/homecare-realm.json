{
  "realm": "homecare",
  "displayName": "HomeCare",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "rememberMe": false,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "vi",
    "en"
  ],
  "defaultLocale": "vi",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(10) and notUsername and notEmail and maxLength(128)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "browserFlow": "homecare browser",
  "roles": {
    "realm": [
      {
        "name": "mfa_required",
        "description": "Kỹ thuật: bắt buộc OTP khi đăng nhập (US-15-007)"
      },
      {
        "name": "CUSTOMER",
        "description": "R01 Khách hàng / người thân"
      },
      {
        "name": "ELDER",
        "description": "R02 Người cao tuổi (đăng nhập OTP)"
      },
      {
        "name": "CAREGIVER_PENDING",
        "description": "Nhân viên đang chờ bệnh viện duyệt (US-03-016)"
      },
      {
        "name": "CAREGIVER",
        "description": "R03/R04 Nhân viên – CHỈ cấp khi bệnh viện đối tác duyệt (OQ-037)"
      },
      {
        "name": "DISPATCHER",
        "description": "R05 Điều phối viên",
        "composite": true,
        "composites": {
          "realm": [
            "mfa_required"
          ]
        }
      },
      {
        "name": "ADMIN",
        "description": "R06 Quản trị",
        "composite": true,
        "composites": {
          "realm": [
            "mfa_required"
          ]
        }
      },
      {
        "name": "ACCOUNTANT",
        "description": "R07 Kế toán",
        "composite": true,
        "composites": {
          "realm": [
            "mfa_required"
          ]
        }
      },
      {
        "name": "PARTNER_ORG",
        "description": "R10 Bệnh viện / cơ sở đối tác",
        "composite": true,
        "composites": {
          "realm": [
            "mfa_required"
          ]
        }
      },
      {
        "name": "SYSTEM",
        "description": "Service account gọi API nội bộ (client credentials)"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-homecare",
    "composite": true,
    "composites": {
      "realm": [
        "CUSTOMER"
      ]
    }
  },
  "clients": [
    {
      "clientId": "homecare-bff",
      "name": "HomeCare web (api-gateway BFF)",
      "description": "Confidential client của api-gateway. Trình duyệt không bao giờ thấy secret hay token (R-08).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_BFF_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "${HOMECARE_WEB_URL}/login/oauth2/code/keycloak",
        "http://localhost:5173/login/oauth2/code/keycloak",
        "http://localhost:8080/login/oauth2/code/keycloak"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${HOMECARE_WEB_URL}/*",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "homecare-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "homecare-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "accountId",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "accountId",
            "claim.name": "accountId",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "partnerOrgId",
