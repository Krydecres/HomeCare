# Copy to infra/.env with:  python scripts/init-dev-env.py   (fills every empty value with a random dev secret)
# NEVER commit infra/.env. Values here must stay empty except non-secret defaults (R-17).

# --- PostgreSQL (1 database "homecare", 1 schema + 1 login role per service – OQ-001)
POSTGRES_PASSWORD=
DB_PASSWORD_IDENTITY=
DB_PASSWORD_CUSTOMER=
DB_PASSWORD_CAREGIVER=
DB_PASSWORD_CATALOG=
DB_PASSWORD_BOOKING=
DB_PASSWORD_DISPATCH=
DB_PASSWORD_CARE_RECORD=
DB_PASSWORD_PAYMENT=
DB_PASSWORD_NOTIFICATION=
DB_PASSWORD_REVIEW=
DB_PASSWORD_INCIDENT=
DB_PASSWORD_REPORT=
DB_PASSWORD_KEYCLOAK=

# --- Redis (gateway sessions) / RabbitMQ
REDIS_PASSWORD=
RABBITMQ_PASSWORD=

# --- Keycloak
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_BFF_CLIENT_SECRET=
KC_SECRET_IDENTITY_SERVICE=
KC_SECRET_CUSTOMER_SERVICE=
KC_SECRET_CAREGIVER_SERVICE=
KC_SECRET_CATALOG_SERVICE=
KC_SECRET_BOOKING_SERVICE=
KC_SECRET_DISPATCH_SERVICE=
KC_SECRET_CARE_RECORD_SERVICE=
KC_SECRET_PAYMENT_SERVICE=
KC_SECRET_NOTIFICATION_SERVICE=
KC_SECRET_REVIEW_SERVICE=
KC_SECRET_INCIDENT_SERVICE=
KC_SECRET_REPORT_SERVICE=
# Password of the dev login users dev.customer, dev.caregiver, dev.admin... (infra/keycloak/homecare-realm.json)
HOMECARE_DEV_USER_PASSWORD=
HOMECARE_WEB_URL=http://localhost:5173

# --- Column encryption key (AES-256, base64 of 32 bytes) – EncryptedStringConverter
HOMECARE_ENCRYPTION_KEY=

# --- S3-compatible storage (Garage)
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=
