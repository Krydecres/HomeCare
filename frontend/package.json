    "leaflet": "^1.9.4",
    "material-symbols": "^0.49.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.3",
    "react-leaflet": "^5.0.0",
    "react-router": "^7.18.6",
    "recharts": "^3.11.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
